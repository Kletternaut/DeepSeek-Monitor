[Desktop Entry]
Type=Application
Name=DeepSeek Proxy
Comment=Start the DeepSeek streaming proxy manually (without systemd)
Icon=/home/USER/DeepSeek-Monitor/assets/deepseek-proxy-256.png
Exec=/home/USER/DeepSeek-Monitor/deepseek-proxy/.venv/bin/python /home/USER/DeepSeek-Monitor/deepseek-proxy/main.py
Terminal=true
Categories=Development;Network;
Keywords=DeepSeek;Proxy;Monitoring;Usage;

# ---------------------------------------------------------------------------
# Example desktop entry to start the proxy manually instead of via systemd.
#
# How to use:
#   1. Replace /home/USER with the absolute path of your installation
#      (the directory created by `git clone`, e.g. /home/alice/DeepSeek-Monitor)
#      in the Icon= and Exec= lines above. Desktop entries do NOT expand
#      shell variables like $HOME, so an absolute path is required.
#   2. Copy this file to ~/.local/share/applications/deepseek-proxy.desktop
#      (or /usr/share/applications/ for all users).
#
# A desktop entry does NOT need the executable bit.
#
# The proxy runs in a terminal (Terminal=true) so you can see its log output
# and stop it with Ctrl+C. For a background service, prefer the systemd unit
# (deepseek-proxy.service) instead.
# ---------------------------------------------------------------------------
