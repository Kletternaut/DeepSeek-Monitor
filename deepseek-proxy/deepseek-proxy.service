# systemd-System-Unit für den DeepSeek-Anthropic-Proxy.
#
# Installation (als root bzw. mit sudo):
#   1. Pfade in dieser Unit an deine Umgebung anpassen (User, Group,
#      WorkingDirectory, ExecStart, EnvironmentFile).
#   2. sudo cp deepseek-proxy.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now deepseek-proxy
#
# Status / Logs:
#   systemctl status deepseek-proxy
#   journalctl -u deepseek-proxy -f
#
# Deaktivieren:
#   sudo systemctl disable --now deepseek-proxy

[Unit]
Description=DeepSeek Anthropic Messages Streaming-Proxy mit Usage-Monitoring
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Service-Benutzer (anpassen bzw. mit `sudo useradd -r deepseek-proxy` anlegen).
User=deepseek-proxy
Group=deepseek-proxy
# Installationsort des Projekts (anpassen).
WorkingDirectory=/opt/deepseek-monitor/deepseek-proxy
ExecStart=/opt/deepseek-monitor/deepseek-proxy/.venv/bin/python /opt/deepseek-monitor/deepseek-proxy/main.py
Environment=PYTHONUNBUFFERED=1
# Optionale InfluxDB-Konfiguration (DEEPSEEK_INFLUX_*). Die Datei enthält ein
# Token, daher mit 0600 ablegen und NICHT committen.
EnvironmentFile=-/etc/deepseek-monitor/influx.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
