# systemd system unit for the DeepSeek-Anthropic proxy.
#
# Installation (as root or with sudo):
#   1. Replace /home/USER with the absolute path of your installation
#      (the directory created by `git clone`, e.g. /home/alice/DeepSeek-Monitor)
#      in the User, Group, WorkingDirectory, ExecStart and EnvironmentFile lines
#      below. The default assumes you run the proxy as your own user.
#   2. sudo cp deepseek-proxy.service /etc/systemd/system/
#   3. sudo systemctl daemon-reload
#   4. sudo systemctl enable --now deepseek-proxy
#
# Status / logs:
#   systemctl status deepseek-proxy
#   journalctl -u deepseek-proxy -f
#
# Disable:
#   sudo systemctl disable --now deepseek-proxy

[Unit]
Description=DeepSeek Anthropic Messages streaming proxy with usage monitoring
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run as your own user (replace USER). For a dedicated service user, create one
# with `sudo useradd -r deepseek-proxy` and set User/Group accordingly.
User=USER
Group=USER
# Installation directory of the project (replace USER).
WorkingDirectory=/home/USER/DeepSeek-Monitor/deepseek-proxy
ExecStart=/home/USER/DeepSeek-Monitor/deepseek-proxy/.venv/bin/python /home/USER/DeepSeek-Monitor/deepseek-proxy/main.py
Environment=PYTHONUNBUFFERED=1
# Optional InfluxDB configuration (DEEPSEEK_INFLUX_*). The file contains a
# token, so store it with 0600 permissions and do NOT commit it.
EnvironmentFile=-/home/USER/DeepSeek-Monitor/deepseek-proxy/influx.env
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
