# Kopiere diese Datei nach `.env` und trage die echten Werte ein.
# `.env` steht bereits in `.gitignore` und wird NICHT committet.

# ---- Lokaler Proxy (bisheriger Standard-Pfad) -------------------------------
# Basis-URL des lokalen deepseek-proxy (Default: http://127.0.0.1:8000)
DEEPSEEK_PROXY_URL=http://127.0.0.1:8000

# ---- Zentrale InfluxDB 2.x (optional, multi-host) ---------------------------
# Sind alle vier gesetzt, liest die Detailseite aus InfluxDB statt aus dem Proxy.
DEEPSEEK_INFLUX_URL=http://192.168.0.32:8086
DEEPSEEK_INFLUX_TOKEN=
DEEPSEEK_INFLUX_ORG=Jolly
DEEPSEEK_INFLUX_BUCKET=deepseek-usage

# Hostname-Tag (nur für den Proxy-Schreibpfad relevant; Default: Hostname)
# DEEPSEEK_INFLUX_HOST_NAME=raspi5
